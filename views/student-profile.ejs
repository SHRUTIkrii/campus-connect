<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Profile</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

</head>

<body>

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="mb-4">Student Academic Profile</h2>


        <form action="/student/profile" method="POST">


            <!-- Name -->

            <div class="mb-3">

                <label class="form-label">Full Name</label>

                <input
                    type="text"
                    name="name"
                    class="form-control"
                    value="<%= student ? student.name : name %>"
                    required>

            </div>


            <!-- Email -->

            <div class="mb-3">

                <label class="form-label">Email</label>

                <input
                    type="email"
                    class="form-control"
                    value="<%= email %>"
                    readonly>

            </div>


            <!-- Phone -->

            <div class="mb-3">

                <label class="form-label">Phone</label>

                <input
                    type="text"
                    name="phone"
                    class="form-control"
                    value="<%= student ? student.phone : '' %>">

            </div>


            <!-- Branch -->

            <div class="mb-3">

                <label class="form-label">Branch</label>

                <select name="branch" class="form-control" required>

                    <option value="">Select Branch</option>

                    <option value="CSE"
                        <%= student && student.branch === "CSE" ? "selected" : "" %>>
                        CSE
                    </option>

                    <option value="ECE"
                        <%= student && student.branch === "ECE" ? "selected" : "" %>>
                        ECE
                    </option>

                    <option value="EE"
                        <%= student && student.branch === "EE" ? "selected" : "" %>>
                        EE
                    </option>

                    <option value="ME"
                        <%= student && student.branch === "ME" ? "selected" : "" %>>
                        ME
                    </option>

                    <option value="CE"
                        <%= student && student.branch === "CE" ? "selected" : "" %>>
                        CE
                    </option>

                </select>

            </div>


            <!-- Semester -->

            <div class="mb-3">

                <label class="form-label">Semester</label>

                <select name="semester" class="form-control">

                    <% for(let i = 1; i <= 8; i++) { %>

                        <option value="<%= i %>"
                            <%= student && student.semester == i ? "selected" : "" %>>
                            <%= i %> Semester
                        </option>

                    <% } %>

                </select>

            </div>


            <!-- CGPA -->

            <div class="mb-3">

                <label class="form-label">CGPA</label>

                <input
                    type="number"
                    name="cgpa"
                    class="form-control"
                    min="0"
                    max="10"
                    step="0.01"
                    value="<%= student ? student.cgpa : '' %>"
                    required>

            </div>


            <!-- 10th -->

            <div class="mb-3">

                <label class="form-label">10th Percentage</label>

                <input
                    type="number"
                    name="tenthPercentage"
                    class="form-control"
                    min="0"
                    max="100"
                    step="0.01"
                    value="<%= student ? student.tenthPercentage : '' %>">

            </div>


            <!-- 12th -->

            <div class="mb-3">

                <label class="form-label">12th Percentage</label>

                <input
                    type="number"
                    name="twelfthPercentage"
                    class="form-control"
                    min="0"
                    max="100"
                    step="0.01"
                    value="<%= student ? student.twelfthPercentage : '' %>">

            </div>


            <!-- Skills -->

            <div class="mb-3">

                <label class="form-label">
                    Skills
                </label>

                <input
                    type="text"
                    name="skills"
                    class="form-control"
                    placeholder="C++, JavaScript, MongoDB, HTML"
                    value="<%= student ? student.skills.join(', ') : '' %>">

                <small class="text-muted">
                    Separate skills using commas.
                </small>

            </div>


            <!-- Graduation Year -->

            <div class="mb-3">

                <label class="form-label">
                    Graduation Year
                </label>

                <input
                    type="number"
                    name="graduationYear"
                    class="form-control"
                    value="<%= student ? student.graduationYear : '' %>"
                    required>

            </div>


            <button
                type="submit"
                class="btn btn-primary">
                Save Profile
            </button>


            <a
                href="/student/dashboard"
                class="btn btn-secondary">
                Back to Dashboard
            </a>

        </form>

    </div>

</div>

</body>

</html>