```html
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Placements | CampusConnect</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #222;
        }

        .header {
            background: #182848;
            color: white;
            padding: 25px 50px;
        }

        .header h1 {
            margin: 0;
        }

        .header p {
            margin-bottom: 0;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 40px auto;
        }

        .container h2 {
            margin-bottom: 25px;
        }

        .placements {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            margin-top: 0;
            color: #182848;
        }

        .card p {
            margin: 10px 0;
        }

        .apply-btn {
            margin-top: 15px;
            padding: 10px 18px;
            background: #182848;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
        }

        .apply-btn:hover {
            background: #243b68;
        }

        .empty {
            background: white;
            padding: 30px;
            border-radius: 10px;
            text-align: center;
        }

    </style>

</head>


<body>


    <div class="header">

        <h1>Available Placements 💼</h1>

        <p>
            Welcome, <%= name %>!
        </p>

    </div>


    <div class="container">

        <h2>Placement Opportunities</h2>


        <% if (placements.length === 0) { %>


            <div class="empty">

                <h3>No placements available yet.</h3>

                <p>
                    New placement opportunities will appear here.
                </p>

            </div>


        <% } else { %>


            <div class="placements">


                <% placements.forEach(placement => { %>


                    <div class="card">


                        <h3>
                            <%= placement.company %>
                        </h3>


                        <p>
                            <strong>Role:</strong>
                            <%= placement.jobRole %>
                        </p>


                        <p>
                            <strong>Location:</strong>
                            <%= placement.location %>
                        </p>


                        <p>
                            <strong>Salary:</strong>
                            <%= placement.salary %>
                        </p>


                        <p>
                            <strong>Eligibility:</strong>
                            <%= placement.eligibility %>
                        </p>


                        <p>
                            <strong>Deadline:</strong>
                            <%= placement.deadline %>
                        </p>


                        <p>
                            <strong>Description:</strong>
                            <%= placement.description %>
                        </p>


                        <!-- APPLY BUTTON -->

                        <form
                            action="/student/apply/<%= placement._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="apply-btn"
                            >
                                Apply Now
                            </button>

                        </form>


                    </div>


                <% }) %>


            </div>


        <% } %>


    </div>


</body>

</html>
```
